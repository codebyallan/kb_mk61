[Unit]
Description=Keyboard daemon (kbdd)
PartOf=default.target
After=default.target

[Service]
Type=simple
ExecStart=/usr/bin/kbdd
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
# The daemon persists LED mode, brightness, and effect speeds here.
# %h/.config/kbdd stores the persistent configuration, while %t contains
# the runtime socket and lock.
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictRealtime=yes

[Install]
WantedBy=default.target
