# kbdd - grant the logged-in user (uaccess) access to supported keyboards'
# hidraw interfaces. Only hidraw is used: the daemon does not read /dev/input
# and does not need access to keyboard events (reducing keylogger exposure).
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1ea7", ATTRS{idProduct}=="9018", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1ea7", ATTRS{idProduct}=="9050", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="2442", ATTRS{idProduct}=="0011", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="2442", ATTRS{idProduct}=="b011", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="2442", ATTRS{idProduct}=="b014", TAG+="uaccess"

# /dev/uinput (key injection) is NOT enabled by default. Uncomment only when
# using KBDD_ENABLE_UINPUT=1, knowing that any process in the session could
# inject keystrokes.
#SUBSYSTEM=="misc", KERNEL=="uinput", TAG+="uaccess"
